  "steps": [
    {
      "text": "Preheat the oven to 350°F (175°C).",
      "section": null,
      "kind": "prep",
      "timers": []
    },
    {
      "text": "Grease a 9x5 inch loaf pan and line it with parchment paper, leaving an overhang on the long sides. Use the parchment overhang as handles later.",
      "section": null,
      "kind": "prep",
      "timers": []
    },
    {
      "text": "In a large bowl, whisk together the flour, baking powder, cardamom, and salt.",
      "section": null,
      "kind": "prep",
      "timers": []
    },
    {
      "text": "In a separate bowl, rub the lemon zest into the sugar with your fingertips until fragrant, then whisk in the yogurt, eggs, oil, and vanilla until smooth.",
      "section": null,
      "kind": "prep",
      "timers": []
    },
    {
      "text": "Fold the dry ingredients into the wet until just combined — do not overmix.",
      "section": null,
      "kind": "prep",
      "timers": []
    },
    {
      "text": "Pour the batter into the prepared pan and smooth the top.",
      "section": null,
      "kind": "prep",
      "timers": []
    },
    {
      "text": "Bake 35 to 40 minutes, until golden and a toothpick inserted in the center comes out clean.",
      "section": null,
      "kind": "cook",
      "timers": [
        {
