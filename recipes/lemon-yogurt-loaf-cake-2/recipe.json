          "duration_seconds_max": 2400,
          "label": "Bake",
          "source_phrase": "Bake 35 to 40 minutes"
        }
      ]
    },
    {
      "text": "Cool in the pan for 10 minutes, then lift out onto a rack to cool completely.",
      "section": null,
      "kind": "cook",
      "timers": [
        {
          "duration_seconds_min": 600,
          "duration_seconds_max": 600,
          "label": "Cool in pan",
          "source_phrase": "Cool in the pan for 10 minutes"
        }
      ]
    },
    {
      "text": "For the glaze, whisk the powdered sugar with 2 tablespoons of lemon juice, adding more juice a little at a time until pourable.",
      "section": "For the glaze",
